<aside>

    {{#empty(context.categories)}}
    Empty.
    {{/empty(context.categories)}}
    {{^empty(context.categories)}}
    
<style>
.left aside a.active {
    font-weight: bold;
}

#docs .left li a {
    padding: 4px 0 4px 1rem;
    border-left: 1px solid #efefef;
}
#docs .left li a.active {
    border-left: 2px solid var(--link-color-active);
    padding-left: 1.25rem;
}
#docs .left ul li a.active {
    color: var(--link-color-active);
}
.left aside details {
    margin-bottom: 0.25rem;
}
.left aside summary {
    margin-bottom: 10px;
}
.left aside details > summary {
    list-style: none;
}

</style>

<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function () {
    let currentUrl = window.location.href;
    //console.log(currentUrl);
    document.querySelectorAll("aside a").forEach(link => {
        if (link.getAttribute("href") === currentUrl) {
            link.classList.add("active");
            let details = link.closest("details");
            if (details) {
                details.open = true;
            }
        }
    });
});
</script>

    <button id="open-modal-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="var(--link-color)" class="size-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
              </svg>
    Search...</button>
    
    {{#context.categories}}

    <details class="{{permalink}}" open>
        <summary style="font-size: 1rem;"><a href="{{permalink}}">{{title}}</a></summary>
        <ul>
            {{#guides}}
            <li><a href="{{permalink}}">{{title}}</a></li>
            {{/guides}}
        </ul>
    </details>
    {{/context.categories}}
    {{/empty(context.categories)}}
</aside>
